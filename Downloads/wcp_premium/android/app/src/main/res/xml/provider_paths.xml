<?xml version="1.0" encoding="utf-8"?>
<!-- Paths the FileProvider (authority "<applicationId>.fileprovider") may share
     as content:// URIs. Chat attachments are written to the app cache via
     path_provider's getTemporaryDirectory() before being opened with the system
     viewer, so cache-path covers them; the external variants are included so a
     downloaded file works regardless of which cache dir path_provider returns. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="cache" path="." />
    <external-cache-path name="external_cache" path="." />
    <external-files-path name="external_files" path="." />
</paths>
